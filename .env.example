# Copy to .env (git-ignored) and fill in. Never commit real values.

# neatlogs — https://docs.neatlogs.com
NEATLOGS_API_KEY=

# Google AI Studio, free tier only — no billing account attached
GEMINI_API_KEY=

# OpenRouter — :free models only, never add credits
OPENROUTER_API_KEY=

# smallest — gpt-5-nano (OpenAI-compatible); added 2026-10-10
SMALLEST_API_KEY=

# Crustdata — https://docs.crustdata.com
CRUSTDATA_API_KEY=

# AWS (optional hosting, organisers' allowance, us-east-1)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
