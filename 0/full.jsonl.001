, .2); scenes.append({\"id\": s[\"id\"], \"start\": s0, \"end\": t})\nfps = old[\"fps\"]; n = int(t * fps) + 1\nenv = [0.0] * n\nfor l in lines:\n    for w in l[\"words\"]:\n        for f in range(int(w[\"t0\"] * fps), min(n, int(w[\"t1\"] * fps) + 1)): env[f] = .6\njson.dump({\"fps\": fps, \"bpm\": old[\"bpm\"], \"duration\": t, \"scenes\": scenes, \"lines\": lines, \"env\": env}, open(sys.argv[3], \"w\", encoding=\"utf-8\"))\nprint(\"duration %.1f s\" % t)\nfor l in lines:\n    if l[\"scene\"] == \"neatlogs\": print(l[\"id\"], round(l[\"start\"], 1), round(l[\"dur\"], 1))\n","structuredPatch":[],"originalFile":null,"userModified":false},"serverClassifierContext":{"request":"f27183b8-7e24-4c88-8fbd-b9e5773852e8","context":{"git_state":{"cwd":"/c/Computer/Coding/neathack/SpeedRadar-NeetHack/demo-video","root":"/c/Computer/Coding/neathack/SpeedRadar-NeetHack","branch":"demo-video","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":6},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"akarsh-dhingra/SpeedRadar-NeetHack","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"akarsh-dhingra/SpeedRadar-NeetHack","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"akarsh-dhingra/SpeedRadar-NeetHack","visibility":"public"}]}},"live_cwd":"/c/Computer/Coding/neathack/SpeedRadar-NeetHack/demo-video","platform":"windows"}},"sourceToolAssistantUUID":"78ef02a1-7d6e-46ff-80a5-018a9dedebd9","permissionDecision":{"decision":"accept","source":"config","reasonType":"other"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Computer\\Coding\\neathack\\SpeedRadar-NeetHack\\demo-video","sessionId":"3ac9aaf8-f1d5-4ab4-b5ac-62a9bdcabd6a","version":"2.1.296","gitBranch":"demo-video","slug":"calm-discovering-rabbit"}
